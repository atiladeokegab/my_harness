# Copy to .env next to docker-compose.yaml, chmod 600, and fill in. Never commit the filled copy.
PENPOT_VERSION=2.18.6
# openssl rand -hex 32
PENPOT_SECRET_KEY=
# openssl rand -hex 24
PENPOT_DB_PASSWORD=
# What browsers use to reach it; keep the default for localhost behind an SSH forward.
PENPOT_PUBLIC_URI=http://localhost:9001
