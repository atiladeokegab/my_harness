# Runtime state, not source. The board and its ledger are data five agents mutate
# continuously; tracking them would make every task a commit and every commit a conflict.
board.json
events.jsonl
inbox/
wake/
.board.lock
.board.wal

# Superseded by git itself — the reason this repo exists.
*.bak

# Python bytecode from importing board.py in tests.
__pycache__/
*.pyc

# Factory runtime: dispatcher/watchdog state, run locks, health log, your own factory config.
state/
run/
watchdog.log
factory.json
