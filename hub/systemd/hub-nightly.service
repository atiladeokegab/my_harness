[Unit]
Description=Hub nightly: archive old inbox messages, gc finished task workspaces, then snapshot hub state to the bucket

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin
Environment=HUB_DIR=%h/hub
# Your roster, HUB_DIR and HUB_CODE_DIR, if not the defaults (runbooks/install-factory-timers.md).
EnvironmentFile=-%h/.config/hub/env
TimeoutStartSec=1h
# A leading '-' lets the snapshot run even when the inbox archive fails.
ExecStart=-/usr/bin/env python3 ${HUB_DIR}/inbox_gc.py
ExecStart=-/usr/bin/env python3 ${HUB_DIR}/board.py ws gc
ExecStart=-/bin/bash ${HUB_DIR}/snapshot.sh full
