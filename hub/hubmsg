#!/usr/bin/env bash
# Cross-protocol wake for the hub.
#
# SendMessage only reaches Claude sessions: it speaks a Claude-specific Unix socket
# protocol, and Codex cannot answer it in either direction. Every hub agent does run
# inside a tmux session named hub-<agent>, so typing into that pane is a wake mechanism
# that works regardless of which vendor's CLI is on the other end.
#
# Queue *and* ping, same as the Claude-native path: `hub notify` is durable but passive,
# the keystroke is what gets attention now.
#
#   hubmsg <Agent> "text" [--task T-003] [--id MESSAGE_ID]
#
# --id reuses a message that `hub done`/`hub new`/`hub notify` already queued: the durable
# half deduplicates on the id, so only the wake is new.
set -euo pipefail

# macOS: prefer Homebrew's GNU coreutils for this process (date +%N, and hubwaked's
# GNU-only flags when it is invoked from here).
if [ "$(uname -s)" = Darwin ]; then
    for _gnubin in /opt/homebrew/opt/coreutils/libexec/gnubin /usr/local/opt/coreutils/libexec/gnubin; do
        [ -d "$_gnubin" ] && { PATH="$_gnubin:$PATH"; break; }
    done
fi

# HUB_DIR is runtime data and may point at a throwaway board. Resolve code from this
# script instead, following the ~/.local/bin/hubmsg symlink used by normal installs.
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" = /* ]] || source_path="$source_dir/$source_path"
done
SCRIPT_DIR="$(cd -P "$(dirname "$source_path")" && pwd)"
RELAY="$SCRIPT_DIR/hubwaked"

usage() { echo "usage: hubmsg <Agent> \"message\" [--task T-003] [--id MESSAGE_ID] [--key K]" >&2; exit 2; }

[ $# -ge 2 ] || usage
target="$1"; shift
message="$1"; shift

task=""
message_id=""
key=()  # --key K replaces the target's earlier message with that key (hub notify --key)
while [ $# -gt 0 ]; do
    case "$1" in
        --task) task="${2:-}"; [ -n "$task" ] || usage; shift 2 ;;
        --id) message_id="${2:-}"; [[ "$message_id" =~ ^[A-Za-z0-9._-]{1,96}$ ]] || usage; shift 2 ;;
        --key) [ -n "${2:-}" ] || usage; key=(--key "$2"); shift 2 ;;
        *) usage ;;
    esac
done

sender="${HUB_AGENT:-${CLAUDE_CODE_SESSION_NAME:-unknown}}"
# Canonicalise: board identities are capitalised, tmux sessions are lowercase.
target="$(tr '[:lower:]' '[:upper:]' <<<"${target:0:1}")$(tr '[:upper:]' '[:lower:]' <<<"${target:1}")"
sess="hub-$(tr '[:upper:]' '[:lower:]' <<<"$target")"

if [ "$target" = "$sender" ]; then
    echo "hubmsg: refusing to message yourself ($sender)" >&2
    exit 1
fi

[ -n "$message_id" ] || message_id="$(date +%s%N)-$$-$RANDOM"

# 1. Durable half — survives restarts, read with `hub inbox`.
if [ -n "$task" ]; then
    hub notify "$target" "$message" --task "$task" --message-id "$message_id" "${key[@]}" >/dev/null
else
    hub notify "$target" "$message" --message-id "$message_id" "${key[@]}" >/dev/null
fi
echo "queued  -> $target inbox"

# 2. Wake half. The prompt is deliberately short and contains no payload: the payload stays
# in the locked durable inbox, and tmux carries only "[hub wake] Run exactly: hub receive
# --pending", an idempotent pull, so retrying an ambiguous wake cannot execute a message twice.
# One request per agent (wake/<Agent>.wake, agent OS §5.4): a message that arrives while one is
# pending only adds its id, so three messages in a minute make one turn.
write_request() {
    request="$("$RELAY" --enqueue "$target" "$message_id")" || {
        echo "pending -> could not queue a wake for $target; the message waits in the inbox (id $message_id)"
        exit 1
    }
}

# Typing into a pane needs the tmux server, and a sandboxed agent (Codex) is blocked from
# connecting to its socket by seccomp -- stat succeeds, connect returns EPERM. That is
# indistinguishable from "target is asleep" unless we look at the error: a reachable
# server says "can't find session", an unreachable one says "error connecting". When we
# cannot reach it ourselves, hand the keystroke to hubwaked, which runs unsandboxed.
err="$(tmux has-session -t "$sess" 2>&1 >/dev/null)" && found=1 || found=0

if [ "$found" = 1 ]; then
    write_request
    set +e
    "$RELAY" --deliver "$request"
    delivery_rc=$?
    set -e
    # rc=3 means the daemon atomically claimed the shared request first. Wait for that
    # single owner's receipt instead of pasting a second copy ourselves.
    if [ "$delivery_rc" -eq 3 ]; then
        set +e
        "$RELAY" --wait "$message_id"
        delivery_rc=$?
        set -e
    fi
    case "$delivery_rc" in
        0) echo "woke    -> $sess (confirmed, id $message_id)" ;;
        4) echo "deferred -> $sess is attached or on a dialog; the relay wakes it once clear (id $message_id)" ;;
        6) echo "busy    -> $sess is mid-turn; its Stop hook or the relay delivers at turn end (id $message_id)" ;;
        *) echo "pending -> $sess (submission unconfirmed; safe idempotent retry queued, id $message_id)"
           exit 1 ;;
    esac
elif grep -qiE "error connecting|operation not permitted|permission denied" <<<"$err"; then
    write_request
    echo "relayed -> $sess (via hubwaked; tmux unreachable from this sandbox, id $message_id)"
else
    echo "asleep  -> $sess not running; message waits in the inbox"
fi
