#!/usr/bin/env bash
# Wake relay for sandboxed agents.
#
# Codex runs under a seccomp filter that blocks connecting to the tmux socket, so
# Prometheus can queue a durable inbox message but cannot type into anyone's pane. It can
# write to $HUB_DIR, so hubmsg drops the keystroke there as a request and this daemon --
# which runs outside any sandbox -- performs it.
#
# hubmsg queues every wake here and then tries `--deliver` itself, so the daemon only picks up
# what a direct attempt left behind: sandboxed senders, busy or attached targets, retries.
#
# Request format v2 (agent OS §5.4): one wake/<Agent>.wake per agent, key=value lines
#   version=2  agent=<Agent>  ids=<id>,<id>  [reset=1  kind=claude|codex]  created=<epoch>
# typed as the single line "[hub wake] Run exactly: hub receive --pending". hubmsg and requeues
# extend ids under a per-agent lock (`--enqueue`); the dispatcher's reset request replaces the file.
# v1 (<message-id>.wake: session, line, version=1, id=) is still delivered for one release.
set -uo pipefail

# macOS: this script uses GNU coreutils flags (readlink -f, stat -c, date -Is, touch -d,
# sha256sum). Homebrew's coreutils provides the GNU versions under gnubin; prefer them for
# this process only. install.sh checks they are present.
if [ "$(uname -s)" = Darwin ]; then
    for _gnubin in /opt/homebrew/opt/coreutils/libexec/gnubin /usr/local/opt/coreutils/libexec/gnubin; do
        [ -d "$_gnubin" ] && { PATH="$_gnubin:$PATH"; break; }
    done
fi

HUB_DIR="${HUB_DIR:-$HOME/hub}"
WAKE_DIR="$HUB_DIR/wake"
LOG="$HUB_DIR/wake/hubwaked.log"
DELIVERED_DIR="$WAKE_DIR/delivered"
FAILED_DIR="$WAKE_DIR/failed"
INFLIGHT_DIR="$WAKE_DIR/inflight"
DEFERRED_DIR="$WAKE_DIR/deferred"
PIDFILE="$WAKE_DIR/hubwaked.pid"
HEARTBEAT="$WAKE_DIR/hubwaked.heartbeat"
CONFIRM_POLLS=48
CONFIRM_POLL_SECONDS=0.25
MAX_LOG_BYTES=$((256 * 1024))
KEEP_LOG_BYTES=$((128 * 1024))
STALE_AFTER_SECONDS=10
RECEIPT_RETENTION_SECONDS=$((24 * 60 * 60))
BUSY_RETRY_SECONDS=15
# A mid-turn heartbeat older than this is a crashed or interrupted turn, not a busy one.
BUSY_HEARTBEAT_MAX_SECONDS="${HUB_BUSY_HEARTBEAT_MAX:-600}"
WAKE_LINE="[hub wake] Run exactly: hub receive --pending"
# Spike T1: Codex takes an Enter that arrives with the typed /new as part of a paste, so pause first.
RESET_ENTER_PAUSE=0.7
RESET_SETTLE_SECONDS=3
AGENT_RE='^[A-Za-z][A-Za-z0-9_-]{0,31}$'  # board.py's rule: hub-<name> sessions may carry _ and -
ID_RE='^[A-Za-z0-9._-]+$'
PRUNE_INTERVAL_SECONDS=300
last_prune=0
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"

mkdir -p "$WAKE_DIR" "$DELIVERED_DIR" "$FAILED_DIR" "$INFLIGHT_DIR" "$DEFERRED_DIR"
# Anyone who can write a request here can cause a keystroke into an agent's pane, so keep
# the queue private to this user rather than world-readable.
chmod 700 "$WAKE_DIR" "$DELIVERED_DIR" "$FAILED_DIR" "$INFLIGHT_DIR" "$DEFERRED_DIR" 2>/dev/null || true
rotate_log() {
    local size=0
    [ -f "$LOG" ] && size="$(stat -c %s "$LOG" 2>/dev/null || echo 0)"
    if [ "$size" -gt "$MAX_LOG_BYTES" ]; then
        tail -c "$KEEP_LOG_BYTES" "$LOG" > "$LOG.tmp.$$" && mv "$LOG.tmp.$$" "$LOG"
    fi
}

log() {
    rotate_log
    printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"
}

# A pane showing a confirmation dialog is NOT safe to type into: the Enter that submits a
# wake also CONFIRMS whatever option is highlighted. Observed live during this cycle -- an
# agent sat on "Yes, and don't ask again for commands that start with `sleep 2`", and a
# wake delivered at that moment would have granted that permission on its behalf.
#
# Deferring is the safe direction: the message stays durable and is retried, whereas a
# wrongly-approved permission cannot be taken back. So this matches known dialog shapes
# from both vendors and defers on any of them.
# Codex screens that swallow typed text: the first-run "Trust this folder?" prompt (a
# wake's keys pick "2. Back to Agent Command Center") and the command center itself.
LOST_WAKE_MARKERS=("Trust this folder" "Agent Command Center")

MODAL_MARKERS=(
    "Press enter to confirm"
    "esc to cancel"
    "don't ask again"
    "what to do differently"
    "Do you want to"
    "Do you trust"
    # Codex's "Agent command center" task list: not a dialog, but text typed there is lost
    # (dry run #4: a wake landed in it and the task never started). Defer until it's closed.
    "Agent command center"
    "enter open"
    # Codex launch dialogs (spike T1): "Update available" runs `npm install -g` on Enter, and
    # "Hooks need review" trusts hooks. Footers: `enter continue · esc skip`, `enter confirm · esc skip`.
    "esc skip"
    "Hooks need review"
    # Claude Code 2.1.302's select dialogs ("Teach auto mode about your environment?") capitalise
    # it: `Enter to confirm · Esc to cancel`. Seen in the T8 live check; the lowercase marker missed it.
    "Esc to cancel"
    "${LOST_WAKE_MARKERS[@]}"
)

# pane_shows SESSION ROWS MARKER...: a marker in the bottom ROWS non-blank rows. Narrow on purpose:
# transcript text that quotes a marker is not a status line or a dialog (Hermes, T-532 review).
pane_shows() {
    local sess="$1" rows="$2" tail_text marker; shift 2
    tail_text="$(tmux capture-pane -p -t "$sess" 2>/dev/null)" || return 1
    tail_text="$(grep -v '^[[:space:]]*$' <<< "$tail_text" | tail -n "$rows")"
    for marker in "$@"; do
        case "$tail_text" in *"$marker"*) return 0 ;; esac
    done
    return 1
}

# Dialogs render at the bottom; 12 rows covers a permission prompt's question, options and footer.
pane_shows_modal() { pane_shows "$1" 12 "${MODAL_MARKERS[@]}"; }

# Agent OS §5.3: mid-turn means the status line (bottom 3 rows) shows `esc to interrupt` (both CLIs),
# or the agent's last heartbeat is a fresh UserPromptSubmit/PostToolUse, i.e. newer than its last Stop.
agent_busy() {
    local sess="$1" beat="$HUB_DIR/state/$2.json"
    pane_shows "$sess" 3 "esc to interrupt" && return 0
    [ -f "$beat" ] || return 1
    [ $(( $(date +%s) - $(stat -c %Y "$beat" 2>/dev/null || echo 0) )) -lt "$BUSY_HEARTBEAT_MAX_SECONDS" ] || return 1
    grep -Eq '"event": *"(UserPromptSubmit|PostToolUse)"' "$beat"
}

# Checked again after Enter: the cursor moves on these screens too, so without this a wake
# that went nowhere is reported confirmed (dry run 2026-10-12).
# 25 rows: the command center's title sits at the top of its list.
pane_lost_wake() { pane_shows "$1" 25 "${LOST_WAKE_MARKERS[@]}"; }

# Agent OS §1 downgrade rule, past the attached/modal/busy guards: print why and succeed when the agent
# did something since the dispatcher's offer (a heartbeat newer than created=) or now holds a claimed
# or blocked task. An unreadable board counts as holding one: a downgrade is the safe direction.
reset_veto() {
    local agent="$1" created="$2" beat="$HUB_DIR/state/$1.json"
    if [ -f "$beat" ] && [ "$(stat -c %Y "$beat" 2>/dev/null || echo 0)" -gt "${created:-0}" ]; then
        echo "heartbeat newer than the offer"; return 0
    fi
    python3 -c '
import json, sys
try:
    tasks = json.load(open(sys.argv[1]))["tasks"]
except (OSError, ValueError, KeyError, TypeError):
    print("board unreadable"); sys.exit(0)
held = {t["status"] for t in tasks if t.get("status") in ("claimed", "blocked")
        and (t.get("agent") or t.get("owner") or "").lower() == sys.argv[2].lower()}
if held:
    print(f"holds a {sorted(held)[0]} task")
sys.exit(0 if held else 1)' "$HUB_DIR/board.json" "$agent"
}

# A row that is only the slash command, give or take a prompt glyph or box border: the composer still
# holds it. Both CLIs clear the screen on /clear and /new (spike T1), so a left-over row means no submit.
composer_shows() {
    local text
    text="$(tmux capture-pane -p -t "$1" 2>/dev/null)" || return 1
    grep -v '^[[:space:]]*$' <<< "$text" | tail -n 12 \
        | grep -Eq "^[[:space:]]*([^[:alnum:][:space:]/]+[[:space:]]*)?$2[[:space:]]*([^[:alnum:][:space:]]+)?[[:space:]]*\$"
}

# Type /clear (Claude) or /new (Codex), pause, Enter, and confirm the pane changed on Enter and the composer let go
# of it. On failure print why, clear the input line and fail, so the caller sends a plain wake instead.
type_reset() {
    local sess="$1" cmd before attempt
    case "$2" in claude) cmd=/clear ;; codex) cmd=/new ;; *) echo "no kind= for the reset"; return 1 ;; esac
    # Empty the composer first: a leftover draft would turn this into the prompt "<draft>/clear" (Hermes,
    # T-534 review). Never a person's draft: the attached guard has already ruled that out.
    tmux send-keys -t "$sess" C-u
    tmux send-keys -t "$sess" -l -- "$cmd"
    sleep "$RESET_ENTER_PAUSE"
    # The screen with the command typed: a fresh session can look exactly like the one before the reset.
    before="$(tmux capture-pane -p -t "$sess" 2>/dev/null)"
    tmux send-keys -t "$sess" Enter
    for attempt in $(seq 1 12); do
        sleep 0.25
        if [ "$(tmux capture-pane -p -t "$sess" 2>/dev/null)" != "$before" ] && ! composer_shows "$sess" "$cmd"; then
            return 0
        fi
    done
    # A prompt typed onto a lingering /new can be lost (spike T1).
    tmux send-keys -t "$sess" C-u
    echo "$cmd not submitted (pane unchanged or the input line still shows it), input line cleared"
    return 1
}

code_fingerprint() {
    sha256sum "$SCRIPT_PATH" | awk '{print $1}'
}

is_relay_pid() {
    local pid="$1"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # ps rather than /proc/<pid>/cmdline, which does not exist on macOS.
    ps -p "$pid" -o command= 2>/dev/null | grep -Fq -- "hubwaked"
}

relay_status() {
    local pid="" recorded_hash="" current_hash state="down" queue=0 failed=0 oldest=0 now_ts age=0 heartbeat_age=999 f mtime newest last_error=""
    [ -f "$PIDFILE" ] && pid="$(sed -n '1p' "$PIDFILE")"
    [ -f "$PIDFILE" ] && recorded_hash="$(sed -n '2p' "$PIDFILE")"
    current_hash="$(code_fingerprint)"
    now_ts="$(date +%s)"
    if [ -f "$HEARTBEAT" ]; then
        heartbeat_age=$((now_ts - $(stat -c %Y "$HEARTBEAT" 2>/dev/null || echo 0)))
    fi
    if { [ -n "$pid" ] && is_relay_pid "$pid"; } || [ "$heartbeat_age" -le 3 ]; then
        if [ "$recorded_hash" = "$current_hash" ]; then state="running"; else state="stale"; fi
    else
        pid="-"
    fi

    shopt -s nullglob
    local pending=("$WAKE_DIR"/*.wake)
    local failures=("$FAILED_DIR"/*.wake)
    queue="${#pending[@]}"
    failed="${#failures[@]}"
    for f in "${pending[@]}"; do
        mtime="$(stat -c %Y "$f" 2>/dev/null || echo "$now_ts")"
        if [ "$oldest" -eq 0 ] || [ "$mtime" -lt "$oldest" ]; then oldest="$mtime"; fi
    done
    [ "$oldest" -eq 0 ] || age=$((now_ts - oldest))
    [ "$age" -ge 0 ] || age=0
    if [ "$failed" -gt 0 ]; then
        newest="$(ls -1t "$FAILED_DIR"/*.wake 2>/dev/null | head -n 1)"
        [ -z "$newest" ] || last_error="$(request_value last_error "$newest" 2>/dev/null || true)"
    fi

    printf 'relay=%s pid=%s queue=%s oldest=%ss failed=%s\n' "$state" "$pid" "$queue" "$age" "$failed"
    [ "$state" != stale ] || printf 'warning: relay code changed since pid %s started; restart required\n' "$pid"
    [ "$age" -le "$STALE_AFTER_SECONDS" ] || printf 'warning: oldest wake is %ss old (threshold %ss)\n' "$age" "$STALE_AFTER_SECONDS"
    [ "$failed" -eq 0 ] || printf 'warning: %s failed wake(s) retained in %s\n' "$failed" "$FAILED_DIR"
    [ -z "$last_error" ] || printf 'last_error: %s\n' "$last_error"
    [ "$state" = running ]
}

acquire_pidfile() {
    local old_pid="" heartbeat_age=999 now_ts
    if [ -f "$PIDFILE" ]; then old_pid="$(sed -n '1p' "$PIDFILE")"; fi
    now_ts="$(date +%s)"
    if [ -f "$HEARTBEAT" ]; then
        heartbeat_age=$((now_ts - $(stat -c %Y "$HEARTBEAT" 2>/dev/null || echo 0)))
    fi
    if { [ -n "$old_pid" ] && is_relay_pid "$old_pid"; } || [ "$heartbeat_age" -le 3 ]; then
        echo "hubwaked already running (pid $old_pid)" >&2
        return 1
    fi
    rm -f "$PIDFILE"
    set -o noclobber
    if ! printf '%s\n%s\n' "$$" "$(code_fingerprint)" > "$PIDFILE" 2>/dev/null; then
        set +o noclobber
        echo "hubwaked start raced another process" >&2
        return 1
    fi
    set +o noclobber
}

cleanup() {
    local recorded=""
    [ -f "$PIDFILE" ] && recorded="$(sed -n '1p' "$PIDFILE")"
    [ "$recorded" != "$$" ] || rm -f "$PIDFILE" "$HEARTBEAT"
    log "hubwaked stopped (pid $$)"
}

prune_delivered() {
    local now_ts marker id mtime
    now_ts="$(date +%s)"
    [ $((now_ts - last_prune)) -ge "$PRUNE_INTERVAL_SECONDS" ] || return 0
    shopt -s nullglob
    for marker in "$DELIVERED_DIR"/*; do
        [ -f "$marker" ] || continue
        id="$(basename "$marker")"
        # A failed request is diagnostic evidence and could be manually re-queued much
        # later. Keep its receipt for as long as that request exists so fail-closed
        # delivery can never become duplicating delivery merely because time passed.
        [ -e "$FAILED_DIR/$id.wake" ] && continue
        mtime="$(stat -c %Y "$marker" 2>/dev/null || echo "$now_ts")"
        [ $((now_ts - mtime)) -lt "$RECEIPT_RETENTION_SECONDS" ] || rm -f "$marker"
    done
    last_prune="$now_ts"
}

request_value() {
    local key="$1" file="$2" value
    value="$(sed -n "s/^${key}=//p" "$file" | head -n 1)"
    [ -n "$value" ] || return 1
    printf '%s' "$value"
}

# Add message ids to wake/<Agent>.wake, creating it if needed, and print its path. Keeps a pending
# request's reset/kind/created, so a message that joins a reset still gets the reset.
enqueue() {
    local agent="$1" new="$2" dest="$WAKE_DIR/$1.wake"
    [[ "$agent" =~ $AGENT_RE ]] || return 1
    (
        flock -w 10 9 || exit 1
        local ids="$new" extra="" created
        created="$(date +%s)"
        if [ -f "$dest" ]; then
            ids="$(request_value ids "$dest"),$new"
            created="$(request_value created "$dest" || date +%s)"
            extra="$(grep -E '^(reset|kind)=' "$dest")"
        fi
        ids="$(tr ',' '\n' <<< "$ids" | awk 'NF && !seen[$0]++' | paste -sd, -)"
        {
            printf 'version=2\nagent=%s\nids=%s\n' "$agent" "$ids"
            [ -z "$extra" ] || printf '%s\n' "$extra"
            printf 'created=%s\n' "$created"
        } > "$dest.tmp.$$" && mv "$dest.tmp.$$" "$dest"
    ) 9> "$WAKE_DIR/.lock-$agent" || return 1
    printf '%s\n' "$dest"
}

cursor_position() {
    local sess="$1"
    tmux display-message -p -t "$sess" '#{cursor_x}:#{cursor_y}' 2>/dev/null
}

recover_inflight() {
    local file base handler id
    shopt -s nullglob
    for file in "$INFLIGHT_DIR"/*.wake; do
        base="$(basename "$file" .wake)"
        handler="${base%%.*}"
        id="${base#*.}"
        [[ "$handler" =~ ^[0-9]+$ ]] || continue
        kill -0 "$handler" 2>/dev/null && continue
        # The owning process died before recording an outcome. Return the durable request
        # to the queue; the delivered receipt still prevents duplication if it got far.
        requeue_request "$file" "$id" 0
        log "recovered inflight id=$id from dead handler=$handler"
    done
}

wait_for_outcome() {
    local id="$1" attempt inflight
    [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
    for attempt in $(seq 1 60); do
        [ ! -e "$DEFERRED_DIR/$id" ] || return 4
        [ ! -e "$FAILED_DIR/$id.wake" ] || return 1
        shopt -s nullglob
        inflight=("$INFLIGHT_DIR"/*."$id".wake)
        if [ -e "$DELIVERED_DIR/$id" ] && [ "${#inflight[@]}" -eq 0 ]; then return 0; fi
        sleep 0.25
    done
    return 1
}

mark_failed() {
    local file="$1" id="$2" reason="$3" dest="$FAILED_DIR/$id.wake"
    printf 'last_error=%s\n' "$reason" >> "$file"
    mv "$file" "$dest"
    log "failed id=$id reason=$reason retained=$dest"
}

requeue_request() {
    local file="$1" id="$2" delay="$3" queued="$WAKE_DIR/$id.wake"
    # v2: merge into whatever hubmsg queued meanwhile rather than overwrite it. A guard failed, so
    # this request's own reset/kind are dropped: a reset is never retried later (agent OS §1).
    if [ "$(request_value version "$file")" = 2 ] && queued="$(enqueue "$id" "$(request_value ids "$file")")"; then
        rm -f "$file"
    else
        queued="$WAKE_DIR/$id.wake"
        mv "$file" "$queued"
    fi
    touch -d "@$(( $(date +%s) + delay ))" "$queued"
}

deliver_request() {
    local file="$1" version id sess line attempt before after pasted claimed agent="" ids i left=0 why="" reset="" veto
    [ -f "$file" ] || { log "request vanished: $file"; return 1; }
    # A read can fail because another handler claimed (moved) the file after the -f check.
    # That is a lost race, not a bad request: report it as claimed-elsewhere (3).
    version="$(request_value version "$file" 2>/dev/null)" || {
        [ -f "$file" ] || return 3
        log "bad request (no version), quarantined: $file"
        mv "$file" "$FAILED_DIR/invalid-$(basename "$file")"
        return 1
    }
    # The claim key: the message id for v1, the agent for v2.
    id="$(request_value "$([ "$version" = 2 ] && echo agent || echo id)" "$file" 2>/dev/null)" && [[ "$id" =~ $ID_RE ]] || {
        [ -f "$file" ] || return 3  # a lost race: another handler claimed it
        # Checked before the claim: the key names the inflight file, so it must not be a path.
        log "bad request (no valid id or agent), quarantined: $file"
        mv "$file" "$FAILED_DIR/invalid-$(basename "$file")"
        return 1
    }
    # The live queue is shared by direct hubmsg calls and the daemon. Rename is the
    # atomic claim: exactly one handler can move the source; losers wait on its outcome.
    if [[ "$file" != "$INFLIGHT_DIR/"* ]]; then
        claimed="$INFLIGHT_DIR/$$.$id.wake"
        if ! mv "$file" "$claimed" 2>/dev/null; then return 3; fi
        file="$claimed"
    fi
    if [ "$version" = 2 ]; then
        agent="$id"
        sess="hub-${agent,,}"
        line="$WAKE_LINE"
        ids="$(request_value ids "$file")"
        # Checked whole before word-splitting, so no id can be a glob or a path.
        [[ "$agent" =~ $AGENT_RE ]] && [[ "$ids" =~ ^[A-Za-z0-9._-]+(,[A-Za-z0-9._-]+)*$ ]] || {
            mark_failed "$file" "${id//[^A-Za-z0-9._-]/_}" "invalid-request"; return 1; }
        ids="${ids//,/ }"
    else
        sess="$(sed -n '1p' "$file")"
        line="$(sed -n '2p' "$file")"
        ids="$id"
        [ -n "$sess" ] || { mark_failed "$file" "$id" "missing-session"; return 1; }
        [ -n "$line" ] || { mark_failed "$file" "$id" "missing-line"; return 1; }
        agent="${sess#hub-}"; agent="${agent^}"
    fi
    if [ "$version" != 1 ] && [ "$version" != 2 ] || [[ ! "$id" =~ $ID_RE ]] || [[ ! "$sess" =~ ^hub-[a-z0-9_-]+$ ]]; then
        mark_failed "$file" "${id//[^A-Za-z0-9._-]/_}" "invalid-request"
        return 1
    fi
    for i in $ids; do rm -f "$DEFERRED_DIR/$i"; done
    [ "$version" != 2 ] || [ "$(request_value reset "$file")" != 1 ] || reset=1

    # Already woken for, already read with `hub receive`, or too old to still be worth a
    # keystroke: drop the wake only. The message itself stays in the durable inbox. (Dry runs
    # #3 and #4: dozens of wakes from earlier days were replayed into a live session, one into
    # a question box.) A v2 request goes only when every id it lists is covered.
    for i in $ids; do
        if [ -e "$DELIVERED_DIR/$i" ]; then why+=";already delivered"
        elif [ -e "$HUB_DIR/inbox/.received/$agent/$i" ]; then why+=";already received"
        elif [[ "${i%%-*}" =~ ^[0-9]{19}$ ]] && (( $(date +%s) - ${i%%-*} / 1000000000 > ${HUB_WAKE_MAX_AGE:-21600} )); then
            why+=";older than ${HUB_WAKE_MAX_AGE:-21600}s, message stays in the inbox"
        else left=$((left + 1)); fi
    done
    if [ "$left" -eq 0 ]; then
        rm -f "$file"
        for i in $ids; do : > "$DELIVERED_DIR/$i"; done
        log "dropped id=$id session=$sess ($(tr ';' '\n' <<< "$why" | awk 'NF && !seen[$0]++' | paste -sd, - | sed 's/,/, /g'))"
        return 0
    fi
    if ! tmux has-session -t "$sess" 2>/dev/null; then
        # The request is already claimed into inflight/, which the scan loop never reads.
        # Put it back in the live queue, or it waits for a relay restart to be recovered.
        requeue_request "$file" "$id" 5
        log "waiting id=$id session=$sess (not running)"
        return 2
    fi
    if [ "$(tmux display-message -p -t "$sess" '#{session_attached}' 2>/dev/null)" -gt 0 ]; then
        # Never inject keystrokes into a pane a person may be editing. Return the claimed
        # request to the durable queue; the daemon will retry after they detach.
        for i in $ids; do : > "$DEFERRED_DIR/$i"; done
        requeue_request "$file" "$id" 5
        # A deferred wake is otherwise invisible to the person at the keyboard. The status
        # line reaches them without touching the input they are typing.
        tmux display-message -t "$sess" "hub: message waiting - run 'hub inbox'" 2>/dev/null || true
        [ -z "$reset" ] || log "reset downgraded: attached id=$id session=$sess"
        log "deferred id=$id session=$sess (attached)"
        return 4
    fi
    if pane_shows_modal "$sess"; then
        # Same treatment as an attached pane: requeue rather than risk confirming a dialog.
        for i in $ids; do : > "$DEFERRED_DIR/$i"; done
        requeue_request "$file" "$id" 5
        [ -z "$reset" ] || log "reset downgraded: confirmation dialog id=$id session=$sess"
        log "deferred id=$id session=$sess (confirmation dialog on screen)"
        return 4
    fi
    if agent_busy "$sess" "$agent"; then
        # Typing into a working TUI queues a draft that waits for the turn to end anyway (9 min
        # once, 2026-10-18). The Stop hook usually hands the messages over first, and then the
        # retry is dropped as already received.
        for i in $ids; do : > "$DEFERRED_DIR/$i"; done
        requeue_request "$file" "$id" "$BUSY_RETRY_SECONDS"
        [ -z "$reset" ] || log "reset downgraded: busy id=$id session=$sess"
        log "busy id=$id session=$sess (mid-turn; retry in ${BUSY_RETRY_SECONDS}s)"
        return 6
    fi
    # Agent OS §1: the guards above already turned an attached, dialog or busy reset into a plain retry
    # (requeue drops reset=). A reset is never retried: it is delivered now or downgraded.
    if [ -n "$reset" ]; then
        if veto="$(reset_veto "$agent" "$(request_value created "$file")")" \
                || ! veto="$(type_reset "$sess" "$(request_value kind "$file")")"; then
            log "reset downgraded: $veto id=$id session=$sess"
        else
            log "reset delivered id=$id session=$sess kind=$(request_value kind "$file")"
            sleep "$RESET_SETTLE_SECONDS"
            # Someone may have attached, or a dialog opened, in the fresh session: defer the line as usual.
            if [ "$(tmux display-message -p -t "$sess" '#{session_attached}' 2>/dev/null)" != 0 ] || pane_shows_modal "$sess"; then
                for i in $ids; do : > "$DEFERRED_DIR/$i"; done
                requeue_request "$file" "$id" 5
                log "deferred id=$id session=$sess (attached or dialog after the reset)"
                return 4
            fi
        fi
    fi

    # Confirm that the literal paste moved the terminal cursor before sending Enter. This
    # works for wrapped and paste-collapsed input without interpreting pane history.
    # Empty the composer first: leftover input (a relay killed mid-type left "[hub wake" in one) would
    # make "<leftover>[hub wake] ..." one garbled prompt. Not attached and no dialog, so not a person's draft.
    tmux send-keys -t "$sess" C-u
    before="$(cursor_position "$sess")"
    tmux send-keys -t "$sess" -l -- "$line"
    for attempt in 1 2 3 4 5; do
        pasted="$(cursor_position "$sess")"
        [ "$pasted" != "$before" ] && break
        sleep "0.$((attempt * 2))"
    done
    pasted="$(cursor_position "$sess")"
    if [ "$pasted" = "$before" ]; then
        requeue_request "$file" "$id" 2
        log "retry queued id=$id reason=paste-not-visible"
        return 5
    fi

    # Send Enter once. Repeated Enter retries can create blank turns, and a busy TUI may
    # render the submitted turn several seconds later even though it accepted the key.
    tmux send-keys -t "$sess" Enter
    for attempt in $(seq 1 "$CONFIRM_POLLS"); do
        sleep "$CONFIRM_POLL_SECONDS"
        after="$(cursor_position "$sess")"
        # Submission clears/moves the input cursor. Exactly one atomic owner can paste,
        # so a second writer can no longer manufacture this state change.
        if [ "$after" != "$pasted" ]; then
            if pane_lost_wake "$sess"; then
                requeue_request "$file" "$id" 2
                log "retry queued id=$id reason=submit-landed-off-prompt"
                return 5
            fi
            for i in $ids; do : > "$DELIVERED_DIR/$i"; done
            rm -f "$file"
            log "delivered id=$id$([ "$version" = 2 ] && echo " ids=${ids// /,}") session=$sess confirm_poll=$attempt"
            return 0
        fi
    done
    # The wake contains only an idempotent `hub receive`, never the payload. Retrying an
    # ambiguous submission is therefore safe: receive() reveals the message at most once.
    requeue_request "$file" "$id" 2
    log "retry queued id=$id reason=submit-unconfirmed"
    return 5
}

if [ "${1:-}" = "--enqueue" ]; then
    [ $# -eq 3 ] && [[ "$3" =~ $ID_RE ]] || { echo "usage: hubwaked --enqueue AGENT MESSAGE_ID" >&2; exit 2; }
    enqueue "$2" "$3"
    exit $?
elif [ "${1:-}" = "--deliver" ]; then
    [ $# -eq 2 ] || { echo "usage: hubwaked --deliver REQUEST" >&2; exit 2; }
    deliver_request "$2"
    exit $?
elif [ "${1:-}" = "--status" ]; then
    [ $# -eq 1 ] || { echo "usage: hubwaked --status" >&2; exit 2; }
    relay_status
    exit $?
elif [ "${1:-}" = "--wait" ]; then
    [ $# -eq 2 ] || { echo "usage: hubwaked --wait MESSAGE_ID" >&2; exit 2; }
    wait_for_outcome "$2"
    exit $?
elif [ $# -gt 0 ]; then
    echo "usage: hubwaked [--enqueue AGENT MESSAGE_ID|--deliver REQUEST|--wait MESSAGE_ID|--status]" >&2
    exit 2
fi

acquire_pidfile || exit 1
trap cleanup EXIT
trap 'exit 0' INT TERM
log "hubwaked started (pid $$)"
touch "$HEARTBEAT"
recover_inflight
prune_delivered

while :; do
    touch "$HEARTBEAT"
    shopt -s nullglob
    for f in "$WAKE_DIR"/*.wake; do
        [ "$(stat -c %Y "$f" 2>/dev/null || date +%s)" -le "$(date +%s)" ] || continue
        # A sleeping target returns 2 and remains queued; other failures quarantine the
        # request. Neither outcome should stop the daemon's scan.
        deliver_request "$f" || true
    done
    prune_delivered
    sleep 1
done
